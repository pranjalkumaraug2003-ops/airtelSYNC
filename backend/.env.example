# Copy to .env for local runs. On Render, add these under Service > Environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated list of frontend URLs allowed to call the API (your Vercel URL).
ALLOWED_ORIGINS=http://localhost:3000
# The case asks us to treat 2026-07-15 as "today" for date checks.
REFERENCE_DATE=2026-07-15
# Optional: full path to tesseract if it is not on PATH (Windows default is auto-detected)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
